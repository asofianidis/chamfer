root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,axaml,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_readonly_field = true:warning

# Geometry code legitimately compares doubles and uses short names (x, y, r).
dotnet_diagnostic.CA1707.severity = none
# Public API documentation is not enforced yet.
dotnet_diagnostic.CS1591.severity = none
# Culture: the app runs with invariant globalization.
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
# Collections exposed as IReadOnlyList are fine.
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1716.severity = none
