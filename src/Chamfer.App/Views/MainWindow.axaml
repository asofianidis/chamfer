<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chamfer.App.ViewModels"
        xmlns:part="using:Chamfer.App.Part"
        xmlns:doc="using:Chamfer.Document"
        xmlns:c="using:Chamfer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Chamfer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="0,0,3,0" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.command">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.relation">
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style Selector="Border.separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="TextBlock.status-under">
      <Setter Property="Foreground" Value="#3B82F6" />
    </Style>
    <Style Selector="TextBlock.redundant">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="TextBlock.status-over">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#EF4444" />
    </Style>
    <Style Selector="TextBlock.warning">
      <Setter Property="Foreground" Value="#F59E0B" />
    </Style>
    <Style Selector="Border.selection-field">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.selection-field.active">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Command bar -->
    <Border DockPanel.Dock="Top" Padding="8,5"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="4">
        <WrapPanel Orientation="Horizontal">
          <Button Classes="tool" Content="New Part" Command="{Binding NewCommand}" ToolTip.Tip="New part (Ctrl+N)" />
          <Button Classes="tool" Content="New Assembly" Command="{Binding NewAssemblyCommand}" ToolTip.Tip="New assembly" />
          <Button Classes="tool" Content="New Drawing" Command="{Binding NewDrawingCommand}" ToolTip.Tip="New drawing of the current part or assembly" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Close Drawing" Command="{Binding CloseDrawingCommand}" ToolTip.Tip="Back to the part" IsVisible="{Binding IsDrawingMode}" />
          <Button Classes="tool" Content="Open" Command="{Binding OpenCommand}" ToolTip.Tip="Open a part (Ctrl+O)" />
          <Button Classes="tool" Content="Save" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S)" />
          <Button Classes="tool" Content="Save As" Command="{Binding SaveAsCommand}" />
          <Button Classes="tool" Content="Import" Command="{Binding ImportCommand}" ToolTip.Tip="Import a STEP or IGES file as a body" />
          <Button Classes="tool" Content="Export" Command="{Binding ExportCommand}" ToolTip.Tip="Export STEP, IGES or STL" />
          <Border Classes="separator" />
          <Button Classes="tool" Content="Undo" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)" />
          <Button Classes="tool" Content="Redo" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)" />
          <Border Classes="separator" />
          <Button Classes="tool" Content="Fit" Command="{Binding ZoomToFitCommand}" ToolTip.Tip="Zoom to fit (F)" />
          <Button Classes="tool" Content="Front" Command="{Binding ShowViewCommand}" CommandParameter="front" ToolTip.Tip="Front view (Ctrl+1)" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Top" Command="{Binding ShowViewCommand}" CommandParameter="top" ToolTip.Tip="Top view (Ctrl+5)" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Right" Command="{Binding ShowViewCommand}" CommandParameter="right" ToolTip.Tip="Right view (Ctrl+4)" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Iso" Command="{Binding ShowViewCommand}" CommandParameter="isometric" ToolTip.Tip="Isometric view (Ctrl+7)" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Normal To" Command="{Binding ShowViewCommand}" CommandParameter="normal" ToolTip.Tip="Look straight at the selected plane or face (Ctrl+8)" IsVisible="{Binding IsModelMode}" />
          <Border Classes="separator" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Shaded+Edges" Command="{Binding SetDisplayStyleCommand}" CommandParameter="ShadedWithEdges" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Shaded" Command="{Binding SetDisplayStyleCommand}" CommandParameter="Shaded" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Hidden Lines" Command="{Binding SetDisplayStyleCommand}" CommandParameter="HiddenLinesRemoved" IsVisible="{Binding IsModelMode}" />
          <Button Classes="tool" Content="Wireframe" Command="{Binding SetDisplayStyleCommand}" CommandParameter="Wireframe" IsVisible="{Binding IsModelMode}" />
          <Border Classes="separator" IsVisible="{Binding IsPartMode}" />
          <Button Classes="tool" Content="Section" Command="{Binding ToggleSectionCommand}" Classes.active="{Binding SectionView}" IsVisible="{Binding IsPartMode}" ToolTip.Tip="Cut the part with a plane to see inside" />
          <Button Classes="tool" Content="Draft Analysis" Command="{Binding ToggleDraftAnalysisCommand}" Classes.active="{Binding DraftAnalysis}" IsVisible="{Binding IsPartMode}" ToolTip.Tip="Colour faces by draft angle against the pull direction" />
          <Button Classes="tool" Content="Zebra" Command="{Binding ToggleZebraCommand}" Classes.active="{Binding ZebraStripes}" IsVisible="{Binding IsPartMode}" ToolTip.Tip="Zebra stripes to judge surface smoothness" />
          <Button Classes="tool" Content="Render" Command="{Binding StartRenderCommand}" IsVisible="{Binding IsModelMode}" ToolTip.Tip="Photorealistic render of the current view" />
        </WrapPanel>

        <!-- Drawing commands -->
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsDrawingMode}">
          <ItemsControl ItemsSource="{Binding DrawingCommands}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommandItem">
                <Button Classes="command" Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Glyph}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- Assembly commands -->
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsAssemblyMode}">
          <ItemsControl ItemsSource="{Binding AssemblyCommands}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommandItem">
                <Button Classes="command" Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Glyph}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- Features -->
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsPartMode}">
          <Button Classes="command primary" Content="Back to Assembly" Command="{Binding ReturnToAssemblyCommand}" IsVisible="{Binding CanReturnToAssembly}" />
          <Button Classes="command" Command="{Binding NewSketchCommand}" ToolTip.Tip="Sketch on a plane or planar face">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="✎" FontWeight="SemiBold" />
              <TextBlock Text="Sketch" />
            </StackPanel>
          </Button>
          <Border Classes="separator" />
          <ItemsControl ItemsSource="{Binding CommandTabs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="tool" Content="{Binding}" FontWeight="SemiBold"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectTabCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="separator" />
          <ItemsControl ItemsSource="{Binding VisibleFeatureCommands}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CommandItem">
                <Button Classes="command" Command="{Binding Command}" ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Glyph}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="separator" />
          <Button Classes="command" Content="Mass Properties" Command="{Binding ShowMassPropertiesCommand}" />
          <Button Classes="command" Content="Measure" Command="{Binding MeasureCommand}" />
          <Button Classes="command" Content="Equations" Command="{Binding ShowEquationsCommand}" ToolTip.Tip="Global variables and equations" />
          <Button Classes="command" Content="Properties" Command="{Binding ShowPropertiesCommand}" ToolTip.Tip="Custom properties: description, part number and more" />
          <Button Classes="command" Content="Units" Command="{Binding ShowUnitsCommand}" ToolTip.Tip="Document units: millimetres, centimetres, metres or inches" />
          <Button Classes="command" Content="Templates" Command="{Binding ShowTemplatesCommand}" ToolTip.Tip="Start new parts from templates, or save this part as one" />
          <Button Classes="command" Content="Library" Command="{Binding ShowDesignLibraryCommand}" ToolTip.Tip="Design library: reusable parts to open or insert" />
          <Button Classes="command" Content="Configurations" Command="{Binding ShowConfigurationsCommand}" ToolTip.Tip="Configurations and design tables" />
          <Button Classes="command" Content="Macro" Command="{Binding ShowMacrosCommand}" ToolTip.Tip="Run, record and save C# macros" />
        </WrapPanel>

        <!-- Sketch tools -->
        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsSketchMode}">
          <Button Classes="command primary" Content="Exit Sketch" Command="{Binding ExitSketchCommand}" ToolTip.Tip="Finish the sketch and rebuild" />
          <Border Classes="separator" />
          <ItemsControl ItemsSource="{Binding Sketch.Tools, FallbackValue={x:Null}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ToolItem">
                <Button Classes="tool" Classes.active="{Binding IsActive}"
                        Content="{Binding Label}" Command="{Binding Activate}"
                        ToolTip.Tip="{Binding Tooltip}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="4,0">
            <TextBlock Text="Sides" VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
            <NumericUpDown Value="{Binding Sketch.PolygonSides, FallbackValue=6}" Minimum="3" Maximum="64" Increment="1"
                           FormatString="0" Width="96" ToolTip.Tip="Number of polygon sides" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="4,0">
            <TextBlock Text="Size" VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
            <NumericUpDown Value="{Binding Sketch.OperationValue, FallbackValue=5}" Minimum="0.001" Increment="1"
                           FormatString="0.###" Width="110" ToolTip.Tip="Fillet radius, chamfer and offset distance, pattern spacing (mm)" />
            <TextBlock Text="Count" VerticalAlignment="Center" FontSize="12" Opacity="0.75" />
            <NumericUpDown Value="{Binding Sketch.PatternCount, FallbackValue=4}" Minimum="2" Maximum="500" Increment="1"
                           FormatString="0" Width="90" ToolTip.Tip="Sketch pattern instances" />
          </StackPanel>
          <Button Classes="tool" Content="Offset" Command="{Binding Sketch.OffsetCommand, FallbackValue={x:Null}}" ToolTip.Tip="Offset the selected curves by Size" />
          <CheckBox Content="Reverse" IsChecked="{Binding Sketch.OffsetReverse, FallbackValue=False}" FontSize="12" Margin="0,0,6,0" ToolTip.Tip="Offset inward / to the other side" />
          <Button Classes="tool" Content="Mirror" Command="{Binding Sketch.MirrorCommand, FallbackValue={x:Null}}" ToolTip.Tip="Mirror the selection about the selected centerline" />
          <Button Classes="tool" Content="Linear Pattern" Command="{Binding Sketch.LinearPatternCommand, FallbackValue={x:Null}}" ToolTip.Tip="Copy the selection Count times along X, Size apart" />
          <Button Classes="tool" Content="Circular Pattern" Command="{Binding Sketch.CircularPatternCommand, FallbackValue={x:Null}}" ToolTip.Tip="Copy the selection Count times around the origin" />
          <Button Classes="tool" Content="Convert Face" Command="{Binding ConvertFaceCommand}" ToolTip.Tip="Project the outline of the face this sketch is on" />
          <Button Classes="tool" Content="Import DXF" Command="{Binding ImportDxfCommand}" ToolTip.Tip="Add lines, arcs, circles and polylines from a DXF file" />
          <Border Classes="separator" />
          <Button Classes="tool" Content="Construction" Command="{Binding Sketch.ToggleConstructionCommand, FallbackValue={x:Null}}"
                  ToolTip.Tip="Toggle construction geometry (X)" />
          <Button Classes="tool" Content="Delete" Command="{Binding Sketch.DeleteCommand, FallbackValue={x:Null}}" ToolTip.Tip="Delete selection (Delete)" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="10,4"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding HintText}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding MessageText}" FontSize="12" Margin="16,0" Foreground="#F59E0B"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding Sketch.CursorText, FallbackValue=''}" FontSize="12" Opacity="0.7" Margin="0,0,20,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Left panel: feature tree, property panel, or sketch relations -->
    <Border DockPanel.Dock="Left" Width="300" Padding="12,4,12,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,1,0">
      <Panel>
        <!-- Feature tree -->
        <DockPanel IsVisible="{Binding ShowTree}">
          <StackPanel DockPanel.Dock="Top" IsVisible="{Binding !IsSketchMode}">
            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,6">
              <TextBlock Classes="section" Text="{Binding TreeTitle}" Margin="0" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" IsVisible="{Binding IsPartMode}" ItemsSource="{Binding ConfigurationNames}" SelectedItem="{Binding ActiveConfigurationName}"
                        MinWidth="120" FontSize="12" ToolTip.Tip="Active configuration" />
            </Grid>
          </StackPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="{Binding IsModelMode}">
            <Button Classes="tool" Content="Edit" Command="{Binding EditSelectedCommand}" IsVisible="{Binding IsPartMode}" ToolTip.Tip="Edit the selected feature (double-click)" />
            <Button Classes="tool" Content="Suppress" Command="{Binding ToggleSuppressCommand}" ToolTip.Tip="Suppress or unsuppress" />
            <Button Classes="tool" Content="Delete" Command="{Binding DeleteSelectedCommand}" />
            <Button Classes="tool" Content="▲" IsVisible="{Binding IsPartMode}" Command="{Binding MoveUpCommand}" ToolTip.Tip="Move the feature earlier in the history" />
            <Button Classes="tool" Content="▼" IsVisible="{Binding IsPartMode}" Command="{Binding MoveDownCommand}" ToolTip.Tip="Move the feature later in the history" />
            <Button Classes="tool" Content="Roll Here" IsVisible="{Binding IsPartMode}" Command="{Binding RollbackHereCommand}" ToolTip.Tip="Roll back to just after this feature" />
            <Button Classes="tool" Content="Roll Forward" IsVisible="{Binding IsPartMode}" Command="{Binding RollForwardCommand}" />
            <ComboBox x:Name="MaterialBox" Margin="0,6,0,0" MinWidth="180" IsVisible="{Binding IsPartMode}" ItemsSource="{x:Static doc:Material.Library}" PlaceholderText="Material…"
                      ToolTip.Tip="Part material">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="doc:Material">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </WrapPanel>
          <Panel>
          <ListBox x:Name="FeatureTree" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}" IsVisible="{Binding !IsSketchMode}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FeatureNode">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Indent}" Opacity="{Binding IsDimmed, Converter={x:Static c:Converters.DimOpacity}}"
                            ToolTip.Tip="{Binding Message}">
                  <TextBlock Text="{Binding Glyph}" Width="16" TextAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="12.5" Classes.error="{Binding HasError}" Classes.warning="{Binding HasWarning}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Sketch mode: selection, relations and the relations list -->
          <Panel IsVisible="{Binding IsSketchMode}">
          <DockPanel DataContext="{Binding Sketch}" x:DataType="vm:SketchViewModel">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Classes="section" Text="SELECTION" />
              <TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" FontSize="12.5" />
              <Button Content="Toggle Driving / Driven" Command="{Binding ToggleDrivingCommand}"
                      IsVisible="{Binding HasSelectedDimension}" Margin="0,8,0,0" FontSize="12" />

              <TextBlock Classes="section" Text="ADD RELATION" />
              <ItemsControl ItemsSource="{Binding Relations}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RelationItem">
                    <Button Classes="relation" Command="{Binding Apply}" IsEnabled="{Binding IsEnabled}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Glyph}" Width="26" TextAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Label}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <TextBlock Classes="section" Text="RELATIONS &amp; DIMENSIONS" Margin="0" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="Show all" IsChecked="{Binding ShowAllRelations}" FontSize="12" />
              </Grid>
            </StackPanel>

            <ListBox ItemsSource="{Binding ConstraintRows}" SelectedItem="{Binding SelectedRow}" Margin="0,6,0,0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ConstraintRow">
                  <Grid ColumnDefinitions="34,*" Margin="0,1">
                    <TextBlock Text="{Binding Glyph}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Text}" FontSize="12.5" Classes.redundant="{Binding IsRedundant}" />
                      <TextBlock Text="{Binding Targets}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          </Panel>
          </Panel>
        </DockPanel>

        <!-- Property panel -->
        <Panel IsVisible="{Binding HasEditor}">
        <DockPanel DataContext="{Binding Editor}" x:DataType="vm:FeatureEditor">
          <StackPanel DockPanel.Dock="Top" Margin="0,8,0,8" Spacing="8">
            <TextBlock Text="{Binding Title, FallbackValue=''}" FontSize="16" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="primary" Content="OK" Width="72" IsVisible="{Binding HasOkCancel, FallbackValue=False}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AcceptEditorCommand, FallbackValue={x:Null}}" />
              <Button Content="Cancel" Width="72" IsVisible="{Binding HasOkCancel, FallbackValue=False}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelEditorCommand, FallbackValue={x:Null}}" />
              <Button Content="Close" Width="72" IsVisible="{Binding IsInfo, FallbackValue=False}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).AcceptEditorCommand, FallbackValue={x:Null}}" />
            </StackPanel>
            <TextBlock Text="{Binding Message, FallbackValue=''}" Classes="error" TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Fields, FallbackValue={x:Null}}">
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:NumberField">
                  <Grid ColumnDefinitions="120,*,Auto" Margin="0,3" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12.5" />
                    <TextBox Grid.Column="1" Text="{Binding Text}" FontSize="12.5" Classes.error="{Binding HasError}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Width="24" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:TextField">
                  <Grid ColumnDefinitions="120,*" Margin="0,3">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12.5" />
                    <TextBox Grid.Column="1" Text="{Binding Text}" FontSize="12.5">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding CommitCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:ChoiceField">
                  <Grid ColumnDefinitions="120,*" Margin="0,3" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12.5" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding Index}" HorizontalAlignment="Stretch" FontSize="12.5" />
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:BoolField">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Value}" Margin="0,2" FontSize="12.5" IsVisible="{Binding IsVisible}" />
                </DataTemplate>
                <DataTemplate DataType="vm:SelectionField">
                  <Button Margin="0,6" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch" Command="{Binding ActivateCommand}" IsVisible="{Binding IsVisible}">
                    <Border Classes="selection-field" Classes.active="{Binding IsActive}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" />
                        <TextBlock Text="{Binding Prompt}" FontSize="11" Opacity="0.6" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="part:SelectionItem">
                              <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
                <DataTemplate DataType="vm:CodeField">
                  <StackPanel Margin="0,4" Spacing="4">
                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.65" />
                    <TextBox Text="{Binding Text}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" Height="260"
                             FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="11.5" />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="vm:ButtonField">
                  <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,4" HorizontalAlignment="Stretch" />
                </DataTemplate>
                <DataTemplate DataType="vm:InfoField">
                  <StackPanel Margin="0,4" IsVisible="{Binding IsVisible}">
                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.65" />
                    <SelectableTextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        </Panel>
      </Panel>
    </Border>

    <!-- 3D view, or the sketch canvas while editing a sketch -->
    <Panel>
      <c:ModelViewport x:Name="Viewport" IsVisible="{Binding IsModelMode}" />
      <c:DrawingCanvas x:Name="Sheet" IsVisible="{Binding IsDrawingMode}" Graphics="{Binding SheetGraphics}" />
      <c:SketchCanvas x:Name="Canvas" Editor="{Binding Sketch.Editor, FallbackValue={x:Null}}" IsVisible="{Binding IsSketchMode}" />
      <Canvas x:Name="Overlay" IsVisible="{Binding IsSketchMode}">
        <TextBox x:Name="DimensionInput" IsVisible="False" Width="110" FontSize="13"
                 PlaceholderText="Value" />
      </Canvas>
    </Panel>
  </DockPanel>
</Window>
