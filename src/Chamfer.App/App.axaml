<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chamfer.App.App"
             Name="Chamfer"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the operating system's light/dark setting. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
